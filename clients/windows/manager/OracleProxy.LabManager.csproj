<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OracleProxy.LabManager</AssemblyName>
    <Version>0.2.0-lab</Version>
    <!-- Production/default builds must NOT contain CI-only privileged SCM controls. -->
    <EnableDisposableLabControls Condition="'$(EnableDisposableLabControls)' == ''">false</EnableDisposableLabControls>
    <DefineConstants Condition="'$(EnableDisposableLabControls)' == 'true'">$(DefineConstants);ENABLE_DISPOSABLE_LAB_CONTROLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableDisposableLabControls)' != 'true'">
    <!-- Removing source items keeps live CI admin pipe code OUT of release assemblies. -->
    <Compile Remove="AdminLabControl.cs;AdminLabControlSelfTests.cs;CiSystemDpapiKeyLease.cs;CiSystemNativeDpapiBridge.cs;CiSystemFixedTargetWfpGuard.cs" />
  </ItemGroup>
  <Target Name="ValidateLabOptIn" BeforeTargets="CoreCompile">
    <Error Condition="'$(EnableDisposableLabControls)' != 'true' and '$(EnableDisposableLabControls)' != 'false'"
           Text="EnableDisposableLabControls must be exactly true or false" />
  </Target>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" Condition="'$(EnableDisposableLabControls)' == 'true'" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>
</Project>
