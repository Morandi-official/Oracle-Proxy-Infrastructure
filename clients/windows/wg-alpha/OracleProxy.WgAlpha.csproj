<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OracleProxy.WgAlpha</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>
  <!-- CI-only live-service entrypoints are ABSENT from public Alpha builds. -->
  <PropertyGroup>
    <EnableR113CiTrial Condition="'$(EnableR113CiTrial)' == ''">false</EnableR113CiTrial>
    <DefineConstants Condition="'$(EnableR113CiTrial)' == 'true'">$(DefineConstants);ENABLE_R113_CI_TRIAL</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateR113CiTrialSwitch" BeforeTargets="CoreCompile">
    <Error Condition="'$(EnableR113CiTrial)' != 'false' and '$(EnableR113CiTrial)' != 'true'" Text="Unrecognized R113 CI compilation flag" />
  </Target>
  <ItemGroup Condition="'$(EnableR113CiTrial)' != 'true'">
    <Compile Remove="CiEmbeddedServiceTrial.cs" />
  </ItemGroup>
  <PropertyGroup>
    <EnableR114KeyCiTrial Condition="'$(EnableR114KeyCiTrial)' == ''">false</EnableR114KeyCiTrial>
    <DefineConstants Condition="'$(EnableR114KeyCiTrial)' == 'true'">$(DefineConstants);ENABLE_R114_KEY_CI_TRIAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableR114KeyCiTrial)' != 'true'">
    <Compile Remove="CiR114KeyFileSmoke.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="OfficialWireGuardBridge.cs" />
    <Compile Include="../service-host/NativeDriverTrust.cs" Link="NativeDriverTrust.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
</Project>
