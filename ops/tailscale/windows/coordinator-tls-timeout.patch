+// IsProxyAppCoordinator restricts the dedicated Windows application's overrides
+// to the same hostname authenticated by its account client.
+func IsProxyAppCoordinator(host string) bool {
+	return host != "" && strings.EqualFold(host, envknob.String("TS_ORACLE_PROXY_TLS_HOST"))
+}
+
+// ProxyAppCoordinatorRoute describes one HTTPS path to the same coordinator.
+type ProxyAppCoordinatorRoute struct {
+	kind    string
+	address netip.Addr
+	proxy   func(*http.Request) (*url.URL, error)
+}
+
+// ProxyAppCoordinatorTransport can reuse a verified public-key request's
+// HTTPS connection for the first Noise upgrade to the same origin.
+type ProxyAppCoordinatorTransport struct {
+	*http.Transport
+	origin string
+	kind   string
+}
+
+// ProxyAppCoordinatorRoutes starts with the account's route when available.
+// The native system proxy and fresh DNS remain independent of that preference.
+func ProxyAppCoordinatorRoutes(systemProxy func(*http.Request) (*url.URL, error)) []ProxyAppCoordinatorRoute {
+	var routes []ProxyAppCoordinatorRoute
+	mode := envknob.String("TS_ORACLE_PROXY_COORDINATOR_ROUTE")
+	if mode == "proxy" {
+		if selected := proxyAppExplicitProxy("TS_ORACLE_PROXY_COORDINATOR_PROXY"); selected != nil {
+			return []ProxyAppCoordinatorRoute{{kind: "configured-proxy", proxy: selected}, {kind: "direct"}}
+		}
+	}
+	if mode == "direct" {
+		if address, err := netip.ParseAddr(envknob.String("TS_ORACLE_PROXY_COORDINATOR_IP")); err == nil {
+			routes = append(routes, ProxyAppCoordinatorRoute{kind: "pinned-direct", address: address})
+		}
+	}
+	pinned := len(routes) > 0
+	if !pinned {
+		routes = append(routes, ProxyAppCoordinatorRoute{kind: "direct"})
+	}
+	if fallback := proxyAppExplicitProxy("TS_ORACLE_PROXY_COORDINATOR_FALLBACK_PROXY"); fallback != nil {
+		routes = append(routes, ProxyAppCoordinatorRoute{kind: "configured-proxy", proxy: fallback})
+		systemProxy = nil // the user-session lookup already supplied this route
+	}
+	if pinned {
+		routes = append(routes, ProxyAppCoordinatorRoute{kind: "direct"})
+	}
+	if systemProxy != nil {
+		routes = append(routes, ProxyAppCoordinatorRoute{kind: "system-proxy", proxy: func(req *http.Request) (*url.URL, error) {
+			endpoint, err := systemProxy(req)
+			if err == nil && endpoint == nil {
+				return nil, errors.New("no system proxy for coordinator")
+			}
+			return endpoint, err
+		}})
+	}
+	return routes
+}
+
+func proxyAppExplicitProxy(env string) func(*http.Request) (*url.URL, error) {
+	endpoint, err := url.Parse(envknob.String(env))
+	if err != nil || (endpoint.Scheme != "http" && endpoint.Scheme != "https") ||
+		endpoint.User != nil || endpoint.Hostname() == "" ||
+		endpoint.RawQuery != "" || endpoint.Fragment != "" ||
+		(endpoint.Path != "" && endpoint.Path != "/") {
+		return nil
+	}
+	return func(*http.Request) (*url.URL, error) { return endpoint, nil }
+}
+
+// Resolver applies a verified IP only to the pinned attempt and original hostname.
+func (route ProxyAppCoordinatorRoute) Resolver(host string, fallback *dnscache.Resolver) *dnscache.Resolver {
+	if !route.address.IsValid() {
+		return fallback
+	}
+	return &dnscache.Resolver{
+		SingleHost:             host,
+		SingleHostStaticResult: []netip.Addr{route.address},
+	}
+}
+
+// Configure sets up one HTTPS coordinator attempt on an independent transport.
+func (route ProxyAppCoordinatorRoute) Configure(tr *http.Transport, target *url.URL) *ProxyAppCoordinatorTransport {
+	origin := proxyAppHTTPSOrigin(target)
+	tr.TLSHandshakeTimeout = 22 * time.Second
+	// The initial public-key request and the protocol upgrade must both use
+	// HTTP/1.1 to share the same TLS (and, if proxied, CONNECT) connection.
+	tr.Protocols = new(http.Protocols)
+	tr.Protocols.SetHTTP1(true)
+	tr.Proxy = func(req *http.Request) (*url.URL, error) {
+		if origin == "" || proxyAppHTTPSOrigin(req.URL) != origin {
+			return nil, errors.New("unexpected coordinator target")
+		}
+		if route.proxy == nil {
+			return nil, nil
+		}
+		return route.proxy(req)
+	}
+	return &ProxyAppCoordinatorTransport{Transport: tr, origin: origin, kind: route.kind}
+}
+
+func proxyAppHTTPSOrigin(u *url.URL) string {
+	if u.Scheme != "https" || u.Hostname() == "" || u.User != nil {
+		return ""
+	}
+	return net.JoinHostPort(strings.ToLower(u.Hostname()), cmp.Or(u.Port(), "443"))
+}
+
+// RaceProxyAppCoordinatorRoutes starts alternates after a short head start for
+// the preferred route or immediately when the running attempts fail.
+func RaceProxyAppCoordinatorRoutes[T any](ctx context.Context, attempts []func(context.Context) (T, error), closeLoser func(T)) (T, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	type result struct {
+		value T
+		err   error
+	}
+	const delay = 200 * time.Millisecond
+	results := make(chan result)
+	next, inFlight := 0, 0
+	start := func() {
+		attempt := attempts[next]
+		next++
+		inFlight++
+		go func() {
+			value, err := attempt(ctx)
+			select {
+			case results <- result{value, err}:
+			case <-ctx.Done():
+				if err == nil && closeLoser != nil {
+					closeLoser(value)
+				}
+			}
+		}()
+	}
+	var errs []error
+	var zero T
+	if len(attempts) == 0 {
+		return zero, errors.New("no coordinator routes")
+	}
+	start()
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	for inFlight > 0 {
+		select {
+		case <-ctx.Done():
+			return zero, ctx.Err()
+		case <-timer.C:
+			if next < len(attempts) {
+				start()
+				timer.Reset(delay)
+			}
+		case res := <-results:
+			inFlight--
+			if res.err == nil {
+				if err := ctx.Err(); err != nil {
+					if closeLoser != nil {
+						closeLoser(res.value)
+					}
+					return zero, err
+				}
+				return res.value, nil
+			}
+			errs = append(errs, res.err)
+			if inFlight == 0 && next < len(attempts) {
+				start()
+				timer.Reset(delay)
+			}
+		}
+	}
+	return zero, errors.Join(errs...)
+}
