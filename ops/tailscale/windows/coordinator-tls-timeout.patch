+// IsProxyAppCoordinator restricts the dedicated Windows application's overrides
+// to the same hostname authenticated by its account client.
+func IsProxyAppCoordinator(host string) bool {
+	return host != "" && strings.EqualFold(host, envknob.String("TS_ORACLE_PROXY_TLS_HOST"))
+}
+
+// ProxyAppCoordinatorIP is the DNS address used by the verified account route.
+func ProxyAppCoordinatorIP(host string) netip.Addr {
+	if !IsProxyAppCoordinator(host) {
+		return netip.Addr{}
+	}
+	ip, _ := netip.ParseAddr(envknob.String("TS_ORACLE_PROXY_COORDINATOR_IP"))
+	return ip
+}
+
+// ConfigureProxyAppCoordinatorTransport shares the authenticated account route
+// for the coordinator and aligns HTTPS CONNECT's timeout with direct TLS.
+func ConfigureProxyAppCoordinatorTransport(tr *http.Transport, host string) {
+	if !IsProxyAppCoordinator(host) {
+		return
+	}
+	tr.TLSHandshakeTimeout = 22 * time.Second
+	var selected *url.URL
+	switch envknob.String("TS_ORACLE_PROXY_COORDINATOR_ROUTE") {
+	case "direct":
+	case "proxy":
+		endpoint, err := url.Parse(envknob.String("TS_ORACLE_PROXY_COORDINATOR_PROXY"))
+		if err != nil || (endpoint.Scheme != "http" && endpoint.Scheme != "https") ||
+			endpoint.User != nil || endpoint.Hostname() == "" ||
+			endpoint.RawQuery != "" || endpoint.Fragment != "" ||
+			(endpoint.Path != "" && endpoint.Path != "/") {
+			return
+		}
+		selected = endpoint
+	default:
+		return
+	}
+	fallback := tr.Proxy
+	tr.Proxy = func(req *http.Request) (*url.URL, error) {
+		if req.URL.Scheme == "https" && strings.EqualFold(req.URL.Hostname(), host) {
+			return selected, nil
+		}
+		if fallback != nil {
+			return fallback(req)
+		}
+		return nil, nil
+	}
+}
 
