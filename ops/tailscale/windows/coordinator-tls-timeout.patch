+func (a *Dialer) dialProxyAppCoordinator(ctx context.Context, prepared *ProxyAppCoordinatorTransport) (*ClientConn, error) {
+	if a.HTTPSPort == NoPort {
+		return nil, errors.New("coordinator requires HTTPS")
+	}
+	ctx = sockstats.WithSockStats(ctx, sockstats.LabelControlClientDialer, a.logf)
+	u := &url.URL{
+		Scheme: "https",
+		Host:   net.JoinHostPort(a.Hostname, strDef(a.HTTPSPort, "443")),
+		Path:   serverUpgradePath,
+	}
+	var attempts []func(context.Context) (*ClientConn, error)
+	if prepared != nil && prepared.origin != proxyAppHTTPSOrigin(u) {
+		prepared = nil
+	}
+	if prepared != nil {
+		attempts = append(attempts, func(ctx context.Context) (*ClientConn, error) {
+			return a.dialURL(ctx, u, netip.Addr{}, "", nil, prepared)
+		})
+	}
+	for _, route := range ProxyAppCoordinatorRoutes(a.getProxyFunc()) {
+		if prepared != nil && route.kind == prepared.kind {
+			continue
+		}
+		attempts = append(attempts, func(ctx context.Context) (*ClientConn, error) {
+			return a.dialURL(ctx, u, netip.Addr{}, "", &route, nil)
+		})
+	}
+	// Each candidate authenticates Noise before it can win. The caller only
+	// receives one connection for registration and map requests.
+	return RaceProxyAppCoordinatorRoutes(ctx, attempts, func(c *ClientConn) { c.Close() })
 }
 
