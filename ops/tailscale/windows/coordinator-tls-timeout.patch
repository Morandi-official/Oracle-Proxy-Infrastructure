+func (c *Direct) loadServerPubKeys(ctx context.Context) (*tailcfg.OverTLSPublicKeyResponse, error) {
+	if len(c.coordinatorKeys) == 0 {
+		return loadServerPubKeys(ctx, c.httpc, c.serverURL)
+	}
+	ctx, cancel := context.WithTimeout(ctx, 26*time.Second)
+	defer cancel()
+
+	var attempts []func(context.Context) (*tailcfg.OverTLSPublicKeyResponse, error)
+	for _, httpc := range c.coordinatorKeys {
+		attempts = append(attempts, func(ctx context.Context) (*tailcfg.OverTLSPublicKeyResponse, error) {
+			defer httpc.CloseIdleConnections()
+			keys, err := loadServerPubKeys(ctx, httpc, c.serverURL)
+			if err == nil && keys.PublicKey.IsZero() {
+				return nil, errors.New("coordinator did not supply a Noise key")
+			}
+			return keys, err
+		})
+	}
+	return controlhttp.RaceProxyAppCoordinatorRoutes(ctx, attempts, nil)
