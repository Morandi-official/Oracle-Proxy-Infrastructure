vpn-admin.morandi.dpdns.org {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    handle_path /downloads/* {
        root * /var/lib/oracle-proxy-downloads
        header X-Content-Type-Options nosniff
        header /diagnostics/*.ps1 Content-Disposition attachment
        header /diagnostics/*.ps1 Content-Type application/octet-stream
        header Cache-Control "public, max-age=86400, immutable"
        file_server
    }
    # Only the local deployment checker may use the application health route.
    handle /api/health {
        respond 404
    }
    handle /api/client/relay {
        reverse_proxy 127.0.0.1:8788
    }
    handle {
        reverse_proxy 127.0.0.1:8787 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
            header_up -Forwarded
        }
    }
}
