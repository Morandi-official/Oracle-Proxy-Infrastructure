[Unit]
Description=Oracle Proxy administrator console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oracle-proxy-admin
Group=oracle-proxy-admin
WorkingDirectory=/opt/oracle-proxy-admin/current
EnvironmentFile=/etc/oracle-proxy-admin/admin.env
EnvironmentFile=/opt/oracle-proxy-admin/current/revision.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/oracle-proxy-admin/current/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8787 --workers 1 --threads 4 --timeout 30 --max-requests 1000 --max-requests-jitter 100 --access-logfile /dev/null
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/oracle-proxy-admin
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
