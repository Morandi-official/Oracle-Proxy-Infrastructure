[Unit]
Description=Oracle Proxy restricted policy and accounting controller
After=network-pre.target netfilter-persistent.service
Before=wg-quick@wg0.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=45
User=root
Group=oracle-proxy-admin
ExecStart=/usr/bin/python3 -I /usr/local/libexec/oracle-project/control-agent.py
Restart=always
RestartSec=2
UMask=0077
StateDirectory=oracle-proxy-control
StateDirectoryMode=0700
RuntimeDirectory=oracle-proxy-control
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/oracle-proxy-control /run/oracle-proxy-control /run/xtables.lock
MemoryMax=192M
TasksMax=32

[Install]
WantedBy=multi-user.target
