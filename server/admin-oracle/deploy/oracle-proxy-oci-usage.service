[Unit]
Description=Oracle Proxy read-only official usage probe
After=network-online.target oracle-proxy-control.service
Wants=network-online.target
[Service]
Type=oneshot
User=root
ExecStart=/opt/oracle-proxy-admin/current/.venv/bin/python -I /usr/local/libexec/oracle-project/oci-usage.py
Environment=OCI_PYTHON_SDK_NO_SERVICE_IMPORTS=true
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=85
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/oracle-proxy-control
MemoryMax=300M
CPUQuota=25%
StandardOutput=journal
StandardError=null
