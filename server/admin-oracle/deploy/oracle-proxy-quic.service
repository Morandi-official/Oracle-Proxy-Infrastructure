[Unit]
Description=Oracle Proxy authenticated WireGuard QUIC relay
After=network.target oracle-proxy-admin.service
Wants=oracle-proxy-admin.service

[Service]
Type=simple
User=oracle-proxy-quic
Group=oracle-proxy-quic
WorkingDirectory=/opt/oracle-proxy-admin/current
ExecStart=/opt/oracle-proxy-admin/current/.venv/bin/python -m relay.quic_server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
# Only this unprivileged relay needs public UDP. Block instance credentials.
IPAddressDeny=169.254.169.254/32
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
