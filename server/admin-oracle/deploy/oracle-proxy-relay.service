[Unit]
Description=Oracle Proxy authenticated WireGuard HTTPS relay
After=network.target oracle-proxy-admin.service
Wants=oracle-proxy-admin.service

[Service]
Type=simple
User=oracle-proxy-relay
Group=oracle-proxy-relay
WorkingDirectory=/opt/oracle-proxy-admin/current
ExecStart=/opt/oracle-proxy-admin/current/.venv/bin/python -m relay.server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
